# Google Gemini API Key
GOOGLE_API_KEY=your_gemini_api_key_here

# PostgreSQL (runs + node logs). Example: postgresql://user:pass@host:5432/dbname
# Leave unset to disable DB logging (runs still work; results also append to results.json).
DATABASE_URL=

# Laptop dev: ignore DATABASE_URL (e.g. VPC-only RDS). Use backend/.env.local — see env.local.sample
# ARBITER_LOCAL_DEV=true

# If Docker is off, Python repos can run pytest on the host (unsafe vs container). Default enabled; set false to require Docker only.
# ARBITER_ALLOW_HOST_TESTS=false

# Local dev only: skip DB connect at startup if RDS is VPC-only (won't migrate schema)
# SKIP_PG_INIT=true

# Seconds (TCP/connect); prevents infinite hang when DB is unreachable
# PG_CONNECT_TIMEOUT=8

# Optional: GitHub Token for forking repositories
# GITHUB_TOKEN=your_github_personal_access_token_here

# Production: comma-separated allowed browser origins for CORS
# CORS_ORIGINS=https://your-app.example.com,http://localhost:5173

# Optional: Backend configuration
PORT=8000
HOST=0.0.0.0
